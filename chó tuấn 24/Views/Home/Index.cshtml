@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Cô Dừa - giới thiệu mật hoa dừa, sản phẩm mang hương vị đặc trưng từ hoa dừa Việt Nam.">
    <meta name="keywords" content="Cô Dừa, mật hoa dừa, mật dừa, sản phẩm từ dừa Việt Nam">
    <meta name="theme-color" content="#fff6c8">
    <title>Cô Dừa – Tinh Hoa Mật Việt | Mật hoa dừa</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/StyleSheet1.css")">
</head>
<body>
    <header class="site-header">
        <a class="brand" href="#trang-chu" aria-label="Cô Dừa - Trang chủ">
            <img src="@Url.Content("~/images/logo-co-dua.jpg")" alt="Logo Cô Dừa">
            <span class="brand-text">CÔ DỪA<small>Tinh Hoa Mật Việt</small></span>
        </a>
        <nav class="main-nav" aria-label="Điều hướng chính">
            <a href="#trang-chu">Trang chủ</a>
            <a href="#gioi-thieu">Giới thiệu</a>
            <a href="#san-pham">Sản phẩm</a>
            <a href="#loi-ich">Điểm nổi bật</a>
            <a href="#lien-he">Liên hệ</a>
        </nav>
        <a class="header-cta" href="#lien-he">Kết nối với Cô <span>↗</span></a>
    </header>

    <main>
        <section class="hero" id="trang-chu">
            <div class="hero-copy">
                <span class="eyebrow"><span class="eyebrow-dot"></span> TINH HOA TỪ HOA DỪA VIỆT</span>
                <h1>Vị ngọt tự nhiên,<br><em>đậm tình đất Việt.</em></h1>
                <p class="hero-description">
                    Cô Dừa giới thiệu mật hoa dừa – món quà mang hương vị mộc mạc,
                    thân thuộc từ cây dừa Việt Nam đến bàn ăn của mỗi gia đình.
                </p>
                <div class="hero-actions">
                    <a class="button button-primary" href="#san-pham">Khám phá sản phẩm <span>↗</span></a>
                    <a class="button button-secondary" href="#gioi-thieu">Chuyện nhà Cô Dừa</a>
                </div>
                <div class="hero-signature">
                    <span class="signature-icon">✳</span>
                    <span>Gần gũi thiên nhiên <b>·</b> Tự hào nông sản Việt</span>
                </div>
            </div>
            <div class="hero-art" aria-label="Logo thương hiệu Cô Dừa">
                <div class="hero-halo"></div>
                <div class="hero-leaf leaf-one">❧</div>
                <div class="hero-leaf leaf-two">❧</div>
                <img src="@Url.Content("~/images/mat-hoa-dua.jpg")"
                     alt="Chai mật hoa dừa Cô Dừa"
                     class="hero-logo">
                <div class="hero-sticker"><span>🥥</span><b>Vị ngọt<br>từ hoa dừa</b></div>
            </div>
            <span class="hero-decoration decor-one">✳</span>
            <span class="hero-decoration decor-two">✦</span>
        </section>

        <div class="marquee" aria-label="Slogan thương hiệu">
            <div>CO DUA · TINH HOA MAT VIET <span>✳</span> NGỌT LÀNH TỪ HOA DỪA <span>✳</span> HƯƠNG VỊ QUÊ NHÀ <span>✳</span> CO DUA · TINH HOA MAT VIET <span>✳</span></div>
        </div>

        <section class="intro section-wrap" id="gioi-thieu">
            <div class="intro-visual">
                <div class="intro-frame">
                    <img src="@Url.Content("~/images/logo-co-dua.jpg")" alt="Logo Cô Dừa">
                </div>
                <span class="round-stamp">TINH HOA<br>MẬT VIỆT</span>
            </div>
            <div class="intro-copy">
                <span class="section-kicker">CÂU CHUYỆN CÔ DỪA</span>
                <h2>Từ hoa dừa,<br><em>gửi vị ngọt quê nhà.</em></h2>
                <p>
                    Cây dừa từ lâu đã gắn bó với đời sống và văn hóa của người Việt.
                    Từ nguồn cảm hứng ấy, Cô Dừa mong muốn giới thiệu mật hoa dừa
                    đến nhiều người hơn – một sản phẩm gợi nhắc sự giản dị,
                    gần gũi và phong phú của nông sản quê hương.
                </p>
                <p>
                    Với Cô Dừa, mỗi sản phẩm không chỉ là hương vị, mà còn là
                    câu chuyện về thiên nhiên, người làm nông và tình yêu dành
                    cho những giá trị Việt.
                </p>
                <a class="text-link" href="#san-pham">Tìm hiểu mật hoa dừa <span>↗</span></a>
            </div>
        </section>

        <section class="product-section section-wrap" id="san-pham">
            <div class="section-heading">
                <span class="section-kicker">SẢN PHẨM CỦA CÔ</span>
                <h2>Mật hoa dừa <em>Cô Dừa</em></h2>
                <p>Khám phá sản phẩm và tìm hiểu thêm về hương vị đặc trưng từ hoa dừa.</p>
            </div>
            <article class="product-feature">
                <div class="product-photo">
                    <span class="photo-label">TINH HOA MẬT VIỆT</span>
                    <img src="@Url.Content("~/images/mat-hoa-dua.jpg")" alt="Sản phẩm mật hoa dừa Cô Dừa">
                    <span class="photo-caption">CÔ DỪA · MẬT HOA DỪA</span>
                </div>
                <div class="product-details">
                    <span class="product-overline">SẢN PHẨM NỔI BẬT</span>
                    <h3>Mật hoa dừa</h3>
                    <p class="product-lead">Vị ngọt mộc mạc, mang dấu ấn của hoa dừa Việt Nam.</p>
                    <p>
                        Mật hoa dừa là sản phẩm được giới thiệu từ nguồn nhựa hoa dừa.
                        Với sắc màu hổ phách bắt mắt, sản phẩm có thể được tìm hiểu
                        và sử dụng tùy theo hướng dẫn, quy cách do nhà sản xuất cung cấp.
                    </p>
                    <div class="product-facts">
                        <div><span class="fact-icon">🌴</span><div><b>Cảm hứng từ hoa dừa</b><small>Gắn với nguồn nguyên liệu bản địa</small></div></div>
                        <div><span class="fact-icon">🍯</span><div><b>Sắc mật hổ phách</b><small>Vẻ ngoài đặc trưng của sản phẩm</small></div></div>
                        <div><span class="fact-icon">🎁</span><div><b>Phù hợp làm quà</b><small>Một lựa chọn mang hương vị Việt</small></div></div>
                    </div>
                    <a class="button button-primary" href="#lien-he">Tìm hiểu sản phẩm <span>↗</span></a>
                    <p class="product-note">Thông tin về thành phần, quy cách, cách dùng và bảo quản vui lòng liên hệ Cô Dừa để được tư vấn chính xác.</p>
                </div>
            </article>
        </section>

        <section class="benefits" id="loi-ich">
            <div class="section-wrap">
                <div class="section-heading">
                    <span class="section-kicker">ĐIỀU LÀM NÊN CÔ DỪA</span>
                    <h2>Mộc mạc từ thiên nhiên,<br><em>trọn vẹn câu chuyện Việt.</em></h2>
                </div>
                <div class="benefit-grid">
                    <article class="benefit-card">
                        <span class="benefit-number">01</span>
                        <span class="benefit-illustration">🌴</span>
                        <h3>Gắn với hoa dừa</h3>
                        <p>Giới thiệu một sản phẩm từ nguồn nguyên liệu quen thuộc của vùng đất Việt Nam.</p>
                    </article>
                    <article class="benefit-card benefit-highlight">
                        <span class="benefit-number">02</span>
                        <span class="benefit-illustration">🍯</span>
                        <h3>Hương vị đặc trưng</h3>
                        <p>Màu mật hổ phách cùng câu chuyện riêng tạo nên nét nhận diện của mật hoa dừa.</p>
                    </article>
                    <article class="benefit-card">
                        <span class="benefit-number">03</span>
                        <span class="benefit-illustration">💚</span>
                        <h3>Lan tỏa giá trị Việt</h3>
                        <p>Cùng kể câu chuyện về nông sản bản địa và những giá trị thân thuộc trong đời sống.</p>
                    </article>
                </div>
                <p class="benefit-disclaimer">Thông tin trên mô tả đặc điểm và câu chuyện sản phẩm; không thay thế thông tin dinh dưỡng hoặc công dụng đã được kiểm chứng.</p>
            </div>
        </section>

        <section class="contact-section section-wrap" id="lien-he">
            <div class="contact-heading">
                <span class="section-kicker">KẾT BẠN VỚI CÔ NHA</span>
                <h2>Liên hệ & <em>mạng xã hội</em></h2>
                <p>Theo dõi Cô Dừa trên các kênh bên dưới để xem thêm thông tin sản phẩm và cập nhật mới nhất.</p>
            </div>
            <div class="social-grid">
                <a class="social-card facebook" href="https://www.facebook.com/p/C%C3%B4-D%E1%BB%ABa-61595120271549/" target="_blank" rel="noopener noreferrer">
                    <span class="social-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v5h4v-5h3l1-4h-4V9c0-.7.3-1 1-1z" /></svg>
                    </span>
                    <span class="social-label">FACEBOOK</span>
                    <strong>Cô Dừa</strong>
                    <span class="social-action">Ghé thăm trang ↗</span>
                </a>
                <a class="social-card instagram" href="https://www.instagram.com/codua.official/" target="_blank" rel="noopener noreferrer">
                    <span class="social-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.7" cy="6.7" r=".8" class="icon-dot" /></svg>
                    </span>
                    <span class="social-label">INSTAGRAM</span>
                    <strong>@@codua.official</strong>
                    <span class="social-action">Xem hình ảnh ↗</span>
                </a>

                <a class="social-card tiktok"
                   href="@("https://www.tiktok.com/" + Url.Encode("@codua.official").Replace("%40", "@"))"
                   target="_blank"
                   rel="noopener noreferrer">

                    <span class="social-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M14 3v11.2a4.2 4.2 0 1 1-3.5-4.1"></path>
                            <path d="M14 3c.5 3.2 2.4 5.1 5.5 5.4"></path>
                        </svg>
                    </span>

                    <span class="social-label">TIKTOK</span>
                    <strong>@@codua.official</strong>
                    <span class="social-action">Xem video ↗</span>
                </a>

            </div>
            <div class="contact-bottom">
                <span>🥥</span>
                <p><b>Cô Dừa – Tinh Hoa Mật Việt</b><br>Hẹn gặp bạn trên hành trình khám phá mật hoa dừa!</p>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <a class="footer-brand" href="#trang-chu">CÔ DỪA <span>· Tinh Hoa Mật Việt</span></a>
        <p>© <span id="year">2026</span> Cô Dừa. Nội dung thuộc về thương hiệu Cô Dừa.</p>
        <a href="#trang-chu">Về đầu trang ↑</a>
    </footer>
    <script>document.getElementById("year").textContent = new Date().getFullYear();</script>
</body>
</html>
